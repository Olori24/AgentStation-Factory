# Production persistence
AGENTSTATION_STORAGE="postgres"
DATABASE_URL=""

# Required server-side secrets
GEMINI_API_KEY=""
AGENTIC_API_KEY=""
ENCRYPTION_KEY=""
SESSION_SECRET=""
AUTH_BOOTSTRAP_TOKEN=""
AUTH_BOOTSTRAP_USER_ID="user-admin-01"
AUTH_ADMIN_EMAIL=""
AUTH_ADMIN_NAME="AgentStation Administrator"
GIT_AUTHOR_NAME="AgentStation Bot"
GIT_AUTHOR_EMAIL="agentstation-bot@users.noreply.github.com"
GITHUB_WEBHOOK_SECRET=""
CRON_SECRET=""
APP_URL=""

# Sandbox security.
#   production  -> must be "docker" (hardened container runtime, fail-closed)
#   development -> "local" runs commands in an isolated per-run directory with a
#                  scrubbed environment so the platform works without Docker.
#   remote      -> dispatch to a dedicated sandbox service (the Docker Compose
#                  dev profile). Set SANDBOX_REMOTE_URL / SANDBOX_REMOTE_TOKEN.
# Leave unset to auto-select: docker in production, local in development.
SANDBOX_RUNTIME="local"
SANDBOX_IMAGE="agentstation-sandbox:latest"

# Only used when SANDBOX_RUNTIME="remote" (docker compose up --build).
SANDBOX_REMOTE_URL=""
SANDBOX_REMOTE_TOKEN=""

# Explicitly enable sandbox/terminal execution. Leave unset to auto-enable for
# the local development runtime; production requires an explicit "true".
TERMINAL_EXECUTION_ENABLED="true"

# Optional server-side Ollama endpoint; never accept a client-provided URL in production.
OLLAMA_URL=""
