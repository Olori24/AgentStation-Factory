# AgentStation Factory — Docker Compose dev profile settings.
#
# Copy this to `.env` (gitignored) to customise the compose profile:
#
#   cp .env.compose.example .env
#   docker compose up --build
#
# Every variable is COMPOSE_-prefixed on purpose: the app's own `.env.example`
# uses the unprefixed names, so the two files never fight over the same value.

# Host port for the command-deck UI / API.
COMPOSE_APP_PORT=3000

# Runtime for mission and terminal execution inside the app container.
#   remote -> dedicated sandbox service in this compose file (default, recommended)
#   local  -> child process inside the app container (no container isolation)
#   docker -> app container spawns containers itself (needs a mounted socket)
COMPOSE_SANDBOX_RUNTIME=remote
COMPOSE_SANDBOX_URL=http://sandbox:7070

# Shared secret between the app and the sandbox service. REQUIRED — there is
# no default, and both the app and the sandbox service refuse to run without it.
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
# Both services read this one value.
COMPOSE_SANDBOX_TOKEN=

# Hardened execution image used for every command.
COMPOSE_SANDBOX_IMAGE=agentstation-sandbox:latest

# Parallel executions the sandbox service accepts before returning 429.
COMPOSE_SANDBOX_CONCURRENCY=4

# Host directory holding per-run workspaces. Must be an absolute path, and it is
# mounted at the identical path inside the sandbox service (see compose file).
# Linux defaults to /tmp. On Docker Desktop use something under $HOME, e.g.
# /Users/you/agentstation-runs, because host file sharing is limited to $HOME.
COMPOSE_SANDBOX_RUN_ROOT=/tmp/agentstation-sandbox-runs
